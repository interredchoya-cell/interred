generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FeasibilityRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  latitude  Float?
  longitude Float?
  status    String   @default("PENDING") // PENDING, HAS_COVERAGE, NO_COVERAGE, CONTACTED
  createdAt DateTime @default(now())
}

